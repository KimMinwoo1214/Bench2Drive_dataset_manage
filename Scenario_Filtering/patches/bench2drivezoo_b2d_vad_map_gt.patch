+def _clip_segment_to_rect(a, b, xmin, xmax, ymin, ymax):
+    dx, dy = float(b[0] - a[0]), float(b[1] - a[1])
+    t0, t1 = 0.0, 1.0
+    for p, q in ((-dx, a[0] - xmin), (dx, xmax - a[0]),
+                 (-dy, a[1] - ymin), (dy, ymax - a[1])):
+        if abs(p) < 1e-12:
+            if q < 0:
+                return None
+            continue
+        ratio = q / p
+        if p < 0:
+            if ratio > t1:
+                return None
+            t0 = max(t0, ratio)
+        else:
+            if ratio < t0:
+                return None
+            t1 = min(t1, ratio)
+    if t0 >= t1:
+        return None
+    direction = np.array([dx, dy])
+    return a + t0 * direction, a + t1 * direction
+
+
+def _clip_polyline_to_rect(points, xmin, xmax, ymin, ymax):
+    xy = np.asarray(points, dtype=float).reshape(-1, 2)
+    pieces = []
+    current = []
+
+    def finish_current():
+        nonlocal current
+        if len(current) >= 2:
+            piece = np.asarray(current, dtype=float)
+            if np.any(np.linalg.norm(np.diff(piece, axis=0), axis=1) > 1e-9):
+                pieces.append(piece)
+        current = []
+
+    for start, end in zip(xy[:-1], xy[1:]):
+        clipped = _clip_segment_to_rect(
+            start, end, xmin=xmin, xmax=xmax, ymin=ymin, ymax=ymax)
+        if clipped is None:
+            finish_current()
+            continue
+        clipped_start, clipped_end = clipped
+        if current and np.allclose(current[-1], clipped_start, atol=1e-8):
+            if not np.allclose(current[-1], clipped_end, atol=1e-8):
+                current.append(clipped_end)
+        else:
+            finish_current()
+            current = [clipped_start, clipped_end]
+    finish_current()
+    return pieces
+
+
+def _build_center_lane_index(lane_points, lane_types):
+    center_lines = [
+        np.asarray(points, dtype=float)[:, :2]
+        for points, lane_type in zip(lane_points, lane_types)
+        if lane_type == 'Center' and len(points) >= 2
+    ]
+    if not center_lines:
+        return None
+    owner_lane = np.concatenate([
+        np.full(len(points), lane_idx, dtype=np.int32)
+        for lane_idx, points in enumerate(center_lines)
+    ])
+    owner_point = np.concatenate([
+        np.arange(len(points), dtype=np.int32) for points in center_lines
+    ])
+    return (
+        cKDTree(np.concatenate(center_lines, axis=0)),
+        center_lines,
+        owner_lane,
+        owner_point,
+    )
+
+
+def _nearest_center_tangent(index, query_xy):
+    if index is None:
+        return None
+    tree, center_lines, owner_lane, owner_point = index
+    _, flat_idx = tree.query(query_xy)
+    lane_idx = int(owner_lane[flat_idx])
+    point_idx = int(owner_point[flat_idx])
+    points = center_lines[lane_idx]
+    lo = max(point_idx - 1, 0)
+    hi = min(point_idx + 1, len(points) - 1)
+    tangent = points[hi] - points[lo]
+    norm = float(np.linalg.norm(tangent))
+    return None if norm < 1e-6 else tangent / norm
+
+
+def _trigger_edge_to_stopline(points, lane_dir):
+    points = np.asarray(points, dtype=float)
+    if len(points) >= 3 and np.allclose(points[0, :2], points[-1, :2]):
+        points = points[:-1]
+    xy = points[:, :2]
+    if len(xy) < 2:
+        return None
+    if lane_dir is None:
+        chosen = min(
+            range(len(xy)),
+            key=lambda idx: np.linalg.norm(xy[(idx + 1) % len(xy)] - xy[idx]),
+        )
+        return np.stack([points[chosen], points[(chosen + 1) % len(xy)]])
+
+    centroid = xy.mean(axis=0)
+    scored = []
+    for idx in range(len(xy)):
+        edge = xy[(idx + 1) % len(xy)] - xy[idx]
+        length = float(np.linalg.norm(edge))
+        if length >= 1e-6:
+            scored.append((abs(float(np.dot(edge / length, lane_dir))), idx))
+    if not scored:
+        return None
+    best_score = min(score for score, _ in scored)
+    candidates = [
+        idx for score, idx in scored
+        if score <= best_score + STOPLINE_EDGE_TOLERANCE
+    ]
+    chosen = min(
+        candidates,
+        key=lambda idx: float(np.dot(
+            (xy[idx] + xy[(idx + 1) % len(xy)]) / 2.0 - centroid,
+            lane_dir,
+        )),
+    )
+    return np.stack([points[chosen], points[(chosen + 1) % len(xy)]])
+
+
+def _extract_stoplines(map_info):
+    lane_points = map_info['lane_points']
+    lane_types = map_info['lane_types']
+    center_index = _build_center_lane_index(lane_points, lane_types)
+    stoplines = []
+    for points, trigger_type in zip(
+            map_info['trigger_volumes_points'],
+            map_info['trigger_volumes_types']):
+        if trigger_type not in STOPLINE_SOURCE_TYPES:
+            continue
+        points = np.asarray(points, dtype=float)
+        lane_dir = _nearest_center_tangent(
+            center_index, points[:, :2].mean(axis=0))
+        segment = _trigger_edge_to_stopline(points, lane_dir)
+        if segment is not None:
+            stoplines.append((segment, trigger_type))
+    return stoplines
