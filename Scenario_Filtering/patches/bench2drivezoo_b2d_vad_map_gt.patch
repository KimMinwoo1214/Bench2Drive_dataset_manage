+def _clip_segment_to_rect(a, b, xmin, xmax, ymin, ymax):
+    """Liang-Barsky clip of segment a->b against an axis-aligned rectangle."""
+    dx, dy = float(b[0] - a[0]), float(b[1] - a[1])
+    t0, t1 = 0.0, 1.0
+    for p, q in ((-dx, a[0] - xmin), (dx, xmax - a[0]),
+                 (-dy, a[1] - ymin), (dy, ymax - a[1])):
+        if abs(p) < 1e-12:
+            if q < 0:
+                return None
+            continue
+        ratio = q / p
+        if p < 0:
+            if ratio > t1:
+                return None
+            t0 = max(t0, ratio)
+        else:
+            if ratio < t0:
+                return None
+            t1 = min(t1, ratio)
+    if t0 >= t1:
+        return None
+    direction = np.array([dx, dy])
+    return a + t0 * direction, a + t1 * direction
+
+
+def _clip_polyline_to_rect(points, xmin, xmax, ymin, ymax):
+    """Clip a polyline into connected ROI pieces without bridging gaps."""
+    xy = np.asarray(points, dtype=float).reshape(-1, 2)
+    pieces = []
+    current = []
+
+    def finish_current():
+        nonlocal current
+        if len(current) >= 2:
+            piece = np.asarray(current, dtype=float)
+            if np.any(np.linalg.norm(np.diff(piece, axis=0), axis=1) > 1e-9):
+                pieces.append(piece)
+        current = []
+
+    for start, end in zip(xy[:-1], xy[1:]):
+        clipped = _clip_segment_to_rect(
+            start, end, xmin=xmin, xmax=xmax, ymin=ymin, ymax=ymax)
+        if clipped is None:
+            finish_current()
+            continue
+        clipped_start, clipped_end = clipped
+        if current and np.allclose(current[-1], clipped_start, atol=1e-8):
+            if not np.allclose(current[-1], clipped_end, atol=1e-8):
+                current.append(clipped_end)
+        else:
+            finish_current()
+            current = [clipped_start, clipped_end]
+    finish_current()
+    return pieces
+
