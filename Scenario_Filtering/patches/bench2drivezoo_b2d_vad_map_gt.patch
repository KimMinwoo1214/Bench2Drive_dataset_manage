+# Trigger-volume types converted into a 2-point stop-line segment instead of
+# a closed polygon. Ported from Scenario_Filtering/visualize_vad_gt.py so
+# b2d_map_infos.pkl and the QA visualization derive stop lines identically.
+STOPLINE_SOURCE_TYPES = ('StopSign', 'TrafficLight')
+STOPLINE_EDGE_TOLERANCE = 0.15
+
+
+def _build_center_lane_index(lane_points, lane_types):
+    center_lines = [
+        np.asarray(points, dtype=float)[:, :2]
+        for points, lane_type in zip(lane_points, lane_types)
+        if lane_type == 'Center' and len(points) >= 2
+    ]
+    if not center_lines:
+        return None
+    owner_lane = np.concatenate([
+        np.full(len(points), lane_idx, dtype=np.int32)
+        for lane_idx, points in enumerate(center_lines)
+    ])
+    owner_point = np.concatenate([
+        np.arange(len(points), dtype=np.int32) for points in center_lines
+    ])
+    return (
+        cKDTree(np.concatenate(center_lines, axis=0)),
+        center_lines,
+        owner_lane,
+        owner_point,
+    )
+
+
+def _nearest_center_tangent(index, query_xy):
+    """Unit tangent of the Center-lane point closest to query_xy (world XY)."""
+    if index is None:
+        return None
+    tree, center_lines, owner_lane, owner_point = index
+    _, flat_idx = tree.query(query_xy)
+    lane_idx = int(owner_lane[flat_idx])
+    point_idx = int(owner_point[flat_idx])
+    points = center_lines[lane_idx]
+    lo = max(point_idx - 1, 0)
+    hi = min(point_idx + 1, len(points) - 1)
+    tangent = points[hi] - points[lo]
+    norm = float(np.linalg.norm(tangent))
+    return None if norm < 1e-6 else tangent / norm
+
+
+def _trigger_edge_to_stopline(points, lane_dir):
+    """Pick the trigger-volume polygon edge that best represents a stop line."""
+    points = np.asarray(points, dtype=float)
+    if len(points) >= 3 and np.allclose(points[0, :2], points[-1, :2]):
+        points = points[:-1]
+    xy = points[:, :2]
+    if len(xy) < 2:
+        return None
+    if lane_dir is None:
+        chosen = min(
+            range(len(xy)),
+            key=lambda idx: np.linalg.norm(xy[(idx + 1) % len(xy)] - xy[idx]),
+        )
+        return np.stack([points[chosen], points[(chosen + 1) % len(xy)]])
+
+    centroid = xy.mean(axis=0)
+    scored = []
+    for idx in range(len(xy)):
+        edge = xy[(idx + 1) % len(xy)] - xy[idx]
+        length = float(np.linalg.norm(edge))
+        if length >= 1e-6:
+            scored.append((abs(float(np.dot(edge / length, lane_dir))), idx))
+    if not scored:
+        return None
+    best_score = min(score for score, _ in scored)
+    candidates = [
+        idx for score, idx in scored
+        if score <= best_score + STOPLINE_EDGE_TOLERANCE
+    ]
+    chosen = min(
+        candidates,
+        key=lambda idx: float(np.dot(
+            (xy[idx] + xy[(idx + 1) % len(xy)]) / 2.0 - centroid,
+            lane_dir,
+        )),
+    )
+    return np.stack([points[chosen], points[(chosen + 1) % len(xy)]])
+
+
+def extract_stoplines(lane_points, lane_types, trigger_points, trigger_types):
+    """Convert every supported trigger-volume polygon into one open stop-line segment."""
+    center_index = _build_center_lane_index(lane_points, lane_types)
+    stopline_points = []
+    stopline_types = []
+    for points, trigger_type in zip(trigger_points, trigger_types):
+        if trigger_type not in STOPLINE_SOURCE_TYPES:
+            continue
+        points = np.asarray(points, dtype=float)
+        lane_dir = _nearest_center_tangent(center_index, points[:, :2].mean(axis=0))
+        segment = _trigger_edge_to_stopline(points, lane_dir)
+        if segment is None:
+            continue
+        stopline_points.append(segment)
+        stopline_types.append(trigger_type)
+    return stopline_points, stopline_types
+
